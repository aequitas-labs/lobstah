// lobstah telemetry receiver: t.lobstah.dev. See README.md for deployment.
// No secret lives in this file.
{
  "name": "lobstah-telemetry",
  "account_id": "cdde311c7a0f2943ec259f0548460a85",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "t.lobstah.dev", "custom_domain": true }],

  // No request logs: Workers Logs, invocation logs and Logpush stay off.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false }
  },
  "logpush": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lobstah-telemetry",
      "database_id": "fb7a04cd-d62a-414d-b990-84fbe5593de0",
      "migrations_dir": "migrations"
    }
  ],

  // Account-local positive integer namespaces, reserved for this receiver.
  // Rate limits key on the install id and on one global key, never on an IP.
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1531", "simple": { "limit": 10, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1532", "simple": { "limit": 1000, "period": 60 } }
  ],

  // Daily retention pass: per-install rows older than 90 days are deleted.
  "triggers": { "crons": ["17 3 * * *"] }
}
