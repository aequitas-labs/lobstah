{
  "description": "Lobstah lifecycle and grant hooks. Session grants match one helm or trap session and a time-limited tool scope. Legacy command/path grants remain trap-only. PreToolUse and PermissionRequest consult the ledger; Claude Code also loads the tool.check mod. Expired or revoked grants do not match. Harness deny rules and organization limits still apply.",
  "modules": [
    "./grants.mjs"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lobstah hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lobstah hook user-prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lobstah hook post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lobstah hook permission-request",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lobstah hook stop",
            "timeout": 14500
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lobstah hook session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lobstah hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
